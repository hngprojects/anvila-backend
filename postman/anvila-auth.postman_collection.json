{
  "info": {
    "_postman_id": "anvila-auth-suite-001",
    "name": "Anvila Auth API",
    "description": "Comprehensive test suite for the Anvila authentication API. Covers email/password registration, login, verification, password reset, refresh/logout/me, Google OAuth, and GitHub OAuth including the link-confirmation flow.\n\n## Environments\n- **Local**: backend running on http://localhost:8000.\n- **Staging**: https://api.staging.anvila.hng14.com.\n\n## Variables consumed\nAll requests reference `{{base_url}}`. Tokens captured by Login flows populate `{{access_token}}` and `{{refresh_token}}`. The OAuth callback and confirm-link requests are manual-only — they require redirect-loop or inbox interaction that Postman cannot drive.\n\n## Folder organization\n1. Health\n2. Email/Password Auth\n3. Email Verification\n4. Password Reset\n5. Session Management\n6. Google OAuth\n7. GitHub OAuth\n8. OAuth Link Confirmation\n9. Admin (gated)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "1. Health",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/v1/health", "host": ["{{base_url}}"], "path": ["api", "v1", "health"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Email/Password Auth",
      "item": [
        {
          "name": "POST /auth/register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"display_name\": \"Test User\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/v1/auth/register", "host": ["{{base_url}}"], "path": ["api", "v1", "auth", "register"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('envelope shape', () => { pm.expect(body).to.have.property('success', true); pm.expect(body).to.have.property('data'); });",
                  "pm.test('user data', () => { pm.expect(body.data).to.have.property('email'); pm.expect(body.data).to.have.property('id'); pm.expect(body.data.email_verified).to.eql(false); });"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /auth/register (duplicate)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/v1/auth/register", "host": ["{{base_url}}"], "path": ["api", "v1", "auth", "register"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409 Conflict', () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /auth/login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/v1/auth/login", "host": ["{{base_url}}"], "path": ["api", "v1", "auth", "login"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('envelope shape', () => pm.expect(body).to.have.property('data'));",
                  "pm.test('tokens present', () => { pm.expect(body.data.tokens.access_token).to.be.a('string'); pm.expect(body.data.tokens.refresh_token).to.be.a('string'); });",
                  "pm.environment.set('access_token', body.data.tokens.access_token);",
                  "pm.environment.set('refresh_token', body.data.tokens.refresh_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /auth/login (wrong password)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"WrongPass1\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/v1/auth/login", "host": ["{{base_url}}"], "path": ["api", "v1", "auth", "login"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    },
